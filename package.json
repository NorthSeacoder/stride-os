{
  "private": true,
  "name": "stride-os",
  "version": "0.1.11",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "turbo run dev",
    "check:ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "release": "bumpp --tag --commit --push",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:setup": "turbo run db:setup",
    "db:studio": "turbo run db:studio",
    "secrets:staged": "gitleaks git --pre-commit --redact --staged --verbose --config .gitleaks.toml",
    "secrets:scan": "gitleaks git --redact --verbose --config .gitleaks.toml"
  },
  "devDependencies": {
    "bumpp": "^10.2.3",
    "eslint": "^10.3.0",
    "turbo": "^2",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.15.0"
}
