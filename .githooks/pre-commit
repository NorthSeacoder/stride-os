#!/usr/bin/env sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required for pre-commit secret scanning." >&2
  echo "Install it first, for example: brew install gitleaks" >&2
  echo "To bypass once: git commit --no-verify" >&2
  exit 1
fi

gitleaks git --pre-commit --redact --staged --verbose --config .gitleaks.toml
