# Database
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/shared_db
DATABASE_SCHEMA=stride_os

# Auth
SESSION_SECRET=change-me-to-a-random-string

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# App
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# Docker / CI
DOCKER_REGISTRY=ghcr.io/northseacoder
DOCKER_IMAGE_NAME=stride-os
IMAGE_TAG=latest

# Traefik / Domain
HOST=your-domain.example
